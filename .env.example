GEOAPIFY_KEY=
GEOAPIFY_SEARCH_KEY=
WEATHER_FORECAST_URL=

AWS_REGION=us-east-1
USERS_TABLE=Users

# Local/Compose only. Use the current Learner Lab credentials in your ignored
# .env file. ECS must use its task role instead.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# Use a random secret with at least 32 bytes. Never commit the real value.
JWT_SECRET=
JWT_EXPIRATION_MINUTES=15
